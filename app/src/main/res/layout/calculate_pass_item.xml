<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/Pass_Layout"
    style="@style/CardItem">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/Pass_Calculate_Progress_Bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/Pass_Data_Group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:padding="16dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/Pass_Time_Start_Layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:gravity="center_vertical"
                android:paddingRight="4dp"
                android:orientation="vertical"
                tools:ignore="NestedWeights">
                <TextView
                    android:id="@+id/Pass_Time_Start_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawableEndCompat="@drawable/ic_circle_indicator"
                    android:drawablePadding="4dp"
                    app:drawableTint="@color/transparent"/>

                <View
                    android:id="@+id/Pass_Time_Start_Under"
                    android:layout_width="74dp"
                    android:layout_height="1dp"
                    android:background="?android:textColor"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView
                android:id="@+id/Pass_Time_End_Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:gravity="center_vertical"
                android:paddingRight="4dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/Pass_Time_Duration_Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:gravity="center_vertical"
                android:paddingRight="2dp"/>

            <LinearLayout
                android:id="@+id/Pass_El_Max_Layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.2"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/Pass_El_Max_Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <View
                    android:id="@+id/Pass_El_Max_Under"
                    android:layout_width="36dp"
                    android:layout_height="1dp"
                    android:background="@color/blue"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>